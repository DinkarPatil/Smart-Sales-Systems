# ──────────────────────────────────────────────────────────────────
# Smart Sales — backend env template
# Copy to `.env` (same folder) and fill in real values. `.env` is gitignored.
# Read by app/core/config.py via pydantic-settings + python-dotenv.
# ──────────────────────────────────────────────────────────────────

# --- Auth -----------------------------------------------------------
# Used to sign access JWTs AND password-reset / email-verification JWTs.
# MUST match SECRET_KEY in frontend-next/.env.local (middleware verifies the JWT).
SECRET_KEY=change-me-to-a-long-random-string

# Anyone with this key can self-register as Admin via POST /auth/register.
# Treat as a credential. Rotate after onboarding the first real admin.
ADMIN_SECRET_KEY=change-me-too

# --- Database -------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./sales_chatbot.db

# --- LLM / RAG ------------------------------------------------------
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2-vision

# --- Email (Resend) -------------------------------------------------
RESEND_API_KEY=
MAIL_FROM=onboarding@resend.dev

# --- Frontend integration -------------------------------------------
# Public URL where the Next.js app is served (used in email links).
FRONTEND_URL=http://localhost:3000

# Where the Next.js login proxy + server components reach this backend.
# Same value as FRONTEND_URL → backend in dev; different host in prod.
BACKEND_API_URL=http://127.0.0.1:8000

# Cookie attributes for the access_token cookie set by the Next.js login proxy.
# COOKIE_SECURE must be `true` whenever the site is served over HTTPS.
COOKIE_SECURE=false
COOKIE_DOMAIN=
